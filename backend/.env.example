PORT=5000
MONGO_URI=mongodb://localhost:27017/doctor-booking
JWT_SECRET=change_this_to_a_random_secret_key

# Email (Nodemailer) — replace with your real Gmail credentials
# Get App Password: myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here

# AI Healthcare Assistant (Google Gemini / Groq)
# Get free Gemini API key: https://aistudio.google.com/
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Groq fallback (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
